{
  "name": "ksr-self-drive-cars",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KSR Self Drive Cars: customer website, booking flow and admin module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run tests/db",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "check:queries": "node tests/db/columns-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
