{
  "name": "ksr-self-drive-cars",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KSR Self Drive Cars: customer website, booking flow and admin module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch-path=server --watch-path=shared server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "create-owner": "node --disable-warning=ExperimentalWarning server/cli.ts create-owner",
    "backup": "node --disable-warning=ExperimentalWarning server/cli.ts backup",
    "seed-demo": "node --disable-warning=ExperimentalWarning server/cli.ts seed-demo",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check:queries": "node --disable-warning=ExperimentalWarning scripts/check-queries.ts",
    "dev:lan": "node scripts/dev.mjs --host",
    "android:apk": "node scripts/android.mjs apk",
    "android:usb": "node scripts/android.mjs usb",
    "android:bundle": "node scripts/android.mjs bundle",
    "android:open": "cap open android",
    "android:assets": "node scripts/android-assets.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@hono/node-server": "^2.1.4",
    "@tanstack/react-query": "^5.104.1",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "heic2any": "^0.0.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.0",
    "nodemailer": "^10.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
