# Edge function secrets.
#   Local:  copy to supabase/functions/.env (loaded by `supabase functions serve`).
#   Hosted: `supabase secrets set --env-file supabase/functions/.env`, or Dashboard > Edge Functions > Secrets.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# Public origin of the website, without a trailing slash. Used in customer upload links, staff
# invite / password-reset redirects (/admin/reset-password) and the "Open:" link in alert emails.
# Local development: http://localhost:8080
SITE_URL=https://ksr-self-drive-cars.lovable.app

# Shared secret the scheduled jobs (pg_cron -> pg_net) send in the x-cron-secret header to
# `notify` and `retention-purge`. Store the same value in Vault as `ksr_cron_secret`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Salt for hashing IP addresses in the booking / upload rate limiter (raw IPs are not stored there).
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=

# Resend (https://resend.com) API key and a sender on a verified domain.
# Leave empty to run without email: queued alerts are then marked "skipped".
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="KSR Self Drive Cars <alerts@your-domain.example>"
