# Copy to .env (or .env.local) for local development. On Fly.io, Render and Railway set
# these as environment variables / secrets instead (see Docs/DEPLOY.md).

# ------------------------------------------------------------------ web app (build time)
# Public site origin, used for canonical URLs, Open Graph and the sitemap.
VITE_SITE_URL=https://ksr-self-drive-cars.lovable.app

# Optional privacy-friendly analytics (Plausible). Leave empty to disable.
VITE_PLAUSIBLE_DOMAIN=

# ------------------------------------------------------------------ server
# Public origin of the site, no trailing slash. Used in emails, invite and upload links.
SITE_URL=http://localhost:8080

# Folder for the SQLite database, uploaded files and backups. Must be a persistent disk
# in production (/data in the Docker image).
DATA_DIR=./data

# Port the server listens on (the Docker image uses 8080; `npm run dev` runs it on 3000).
# PORT=3000

# Long random secrets, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# APP_SECRET signs document links and encrypts two-step secrets: keep it stable, or every
# authenticator app has to be set up again. Without it, one is generated in DATA_DIR/.app-secret.
APP_SECRET=
# Salt for hashing IP addresses in rate limits (defaults to APP_SECRET).
RATE_LIMIT_SALT=

# Trust X-Forwarded-For from the platform's proxy (Fly.io, Render, Railway). Set to false
# only when the server is reachable directly, without a proxy in front.
TRUST_PROXY=true

# ------------------------------------------------------------------ email (SMTP)
# Any provider: Gmail / Google Workspace (smtp.gmail.com, 587, app password), Zoho
# (smtp.zoho.in), Outlook (smtp.office365.com), Brevo, Mailgun, Amazon SES…
# Leave SMTP_HOST empty to write emails to the server log instead of sending them.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (TLS from the start); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KSR Self Drive Cars <no-reply@example.com>"

# ------------------------------------------------------------------ first start
# Creates the Owner account on first boot if there is no Owner yet. Remove OWNER_PASSWORD
# after signing in (or use `npm run create-owner -- --email … --name …` instead).
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Owner

# ------------------------------------------------------------------ advanced
# Built web app served by the server (output of `npm run build`).
# DIST_DIR=./dist
# Scheduled jobs (emails, reminders, retention, backups) run in the server process.
# RUN_JOBS=true
