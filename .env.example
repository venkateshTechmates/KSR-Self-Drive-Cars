# Supabase project (Settings > API). The publishable/anon key is safe for the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Public site origin, used for canonical URLs, Open Graph and the sitemap.
VITE_SITE_URL=https://ksr-self-drive-cars.lovable.app

# Optional privacy-friendly analytics (Plausible). Leave empty to disable.
VITE_PLAUSIBLE_DOMAIN=
